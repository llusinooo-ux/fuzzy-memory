      <Item class="LocalScript" referent="414">
        <Properties>
          <string name="Name">FindBrainrotsUI</string>
          <bool name="Disabled">false</bool>
          <token name="RunContext">0</token>
          <ProtectedString name="Source">-- FIND FOR BRAINROTS - interfaz para PC y celular
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local sync = ReplicatedStorage:WaitForChild("FindBrainrotsSync")
local gui = Instance.new("ScreenGui")
gui.Name = "FindBrainrotsHUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.Parent = player:WaitForChild("PlayerGui")

local function new(class, parent, props)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    o.Parent = parent
    return o
end
local function corner(parent, n)
    new("UICorner", parent, {CornerRadius = UDim.new(0,n)})
end
local function label(parent, text, pos, size, fontSize, color)
    return new("TextLabel", parent, {Text=text, Position=pos, Size=size,
        BackgroundTransparency=1, TextColor3=color or Color3.fromRGB(255,255,255),
        TextSize=fontSize, TextWrapped=true, Font=Enum.Font.GothamBold})
end
local panel = new("Frame", gui, {Size=UDim2.fromOffset(280,76), Position=UDim2.fromOffset(12,12),
    BackgroundColor3=Color3.fromRGB(24,29,47), BorderSizePixel=0})
corner(panel,12)
label(panel,"🧠 FIND FOR BRAINROTS", UDim2.fromOffset(12,7), UDim2.new(1,-24,0,24),17)
local counter = label(panel,"0 / 20 encontrados",UDim2.fromOffset(12,33),UDim2.new(1,-24,0,17),14,Color3.fromRGB(246,216,91))
local money = label(panel,"$0  •  $0/s",UDim2.fromOffset(12,51),UDim2.new(1,-24,0,17),13,Color3.fromRGB(119,255,158))

local openButton = new("TextButton",gui,{Text="📖 ÍNDICE",TextSize=17,Font=Enum.Font.GothamBold,
    TextColor3=Color3.new(1,1,1),BackgroundColor3=Color3.fromRGB(60,112,226),BorderSizePixel=0,
    Size=UDim2.fromOffset(126,44),AnchorPoint=Vector2.new(1,1),Position=UDim2.new(1,-12,1,-12)})
corner(openButton,12)
local book = new("Frame",gui,{Visible=false,Size=UDim2.new(0.86,0,0.72,0),
    Position=UDim2.fromScale(0.5,0.5),AnchorPoint=Vector2.new(0.5,0.5),
    BackgroundColor3=Color3.fromRGB(22,26,42),BorderSizePixel=0})
new("UISizeConstraint",book,{MaxSize=Vector2.new(440,580),MinSize=Vector2.new(220,230)})
corner(book,16)
label(book,"🧠 COLECCIÓN",UDim2.fromOffset(16,10),UDim2.new(1,-70,0,42),21)
local close = new("TextButton",book,{Text="✕",Size=UDim2.fromOffset(40,40),
    Position=UDim2.new(1,-49,0,11),BackgroundColor3=Color3.fromRGB(183,57,76),
    TextColor3=Color3.new(1,1,1),TextSize=22,Font=Enum.Font.GothamBold})
corner(close,10)
local scroll = new("ScrollingFrame",book,{Position=UDim2.fromOffset(12,62),
    Size=UDim2.new(1,-24,1,-74),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=6,
    CanvasSize=UDim2.new(0,0,0,0),AutomaticCanvasSize=Enum.AutomaticSize.Y})
new("UIListLayout",scroll,{Padding=UDim.new(0,6),SortOrder=Enum.SortOrder.LayoutOrder})
local toast = label(gui,"",UDim2.new(0.5,-180,0.83,0),UDim2.fromOffset(360,36),19,Color3.fromRGB(255,241,153))
toast.Visible = false

openButton.MouseButton1Click:Connect(function() book.Visible = not book.Visible end)
close.MouseButton1Click:Connect(function() book.Visible = false end)

local lastToast = 0
sync.OnClientEvent:Connect(function(data)
    if data.toast then
        lastToast += 1
        local current = lastToast
        toast.Text = data.toast
        toast.Visible = true
        task.delay(3,function() if lastToast == current then toast.Visible = false end end)
    end
    if data.items then
        local found = 0
        for _, child in ipairs(scroll:GetChildren()) do
            if child:IsA("TextLabel") then child:Destroy() end
        end
        for i, item in ipairs(data.items) do
            if item.found then found += 1 end
            local txt = (item.found and "✅ " or "🔒 ") .. (item.found and item.title or "???")
                .. "  |  $" .. item.income .. "/s"
            local row = label(scroll,txt,UDim2.fromOffset(0,0),UDim2.new(1,-10,0,40),14,
                item.found and Color3.fromRGB(135,255,178) or Color3.fromRGB(201,211,230))
            row.LayoutOrder = i
            row.BackgroundTransparency = 0
            row.BackgroundColor3 = Color3.fromRGB(37,43,64)
            corner(row,8)
        end
        counter.Text = tostring(found) .. " / " .. tostring(#data.items) .. " encontrados"
    end
end)
local stats = player:WaitForChild("leaderstats")
local coins = stats:WaitForChild("Coins")
local income = stats:WaitForChild("Income")
local function refresh() money.Text = "$" .. coins.Value .. "  •  $" .. income.Value .. "/s" end
coins.Changed:Connect(refresh)
income.Changed:Connect(refresh)
refresh()
sync:FireServer("Get")
