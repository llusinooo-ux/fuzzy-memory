  <Item class="ReplicatedStorage" referent="408">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="RemoteEvent" referent="409">
      <Properties>
        <string name="Name">FindBrainrotsSync</string>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="410">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="411">
      <Properties>
        <string name="Name">FindBrainrotsServer</string>
        <bool name="Disabled">false</bool>
        <token name="RunContext">0</token>
        <ProtectedString name="Source">-- FIND FOR BRAINROTS - kit original gratuito (servidor)
-- Personaliza los modelos en Workspace &gt; Brainrots y los ingresos en sus IntValues.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local store = DataStoreService:GetDataStore("FindBrainrotsKit_v1")
local folder = workspace:WaitForChild("Brainrots")
local sync = ReplicatedStorage:FindFirstChild("FindBrainrotsSync") or Instance.new("RemoteEvent")
sync.Name = "FindBrainrotsSync"
sync.Parent = ReplicatedStorage

local entries = {}
for _, model in ipairs(folder:GetChildren()) do
    if model:IsA("Model") then
        local nameVal = model:FindFirstChild("DisplayName")
        local incomeVal = model:FindFirstChild("Income")
        local hitbox = model:FindFirstChild("CollectPart")
        local prompt = hitbox and hitbox:FindFirstChildOfClass("ProximityPrompt")
        if nameVal and incomeVal and hitbox and prompt then
            table.insert(entries, {id = model.Name, title = nameVal.Value, income = incomeVal.Value,
                hitbox = hitbox, prompt = prompt})
        end
    end
end
table.sort(entries, function(a,b) return a.id &lt; b.id end)

local state = {}
local function summary(player)
    local s = state[player]
    if not s then return end
    local catalog = {}
    for _, item in ipairs(entries) do
        table.insert(catalog, {id=item.id, title=item.title, income=item.income,
            found = s.found[item.id] == true})
    end
    sync:FireClient(player, {items = catalog})
end

local function recalc(player)
    local s = state[player]
    if not s then return end
    local income, count = 0, 0
    for _, item in ipairs(entries) do
        if s.found[item.id] then
            income += item.income
            count += 1
        end
    end
    s.income = income
    local stats = player:FindFirstChild("leaderstats")
    if stats then
        stats.Coins.Value = math.floor(s.coins)
        stats.Found.Value = count
        stats.Income.Value = income
    end
end

local function save(player)
    local s = state[player]
    if not s then return end
    local data = {coins = math.floor(s.coins), found = s.found, lastSeen = os.time()}
    local success, err = pcall(function()
        store:SetAsync("p_" .. player.UserId, data)
    end)
    if not success then warn("No se guardó progreso de " .. player.Name .. ": " .. tostring(err)) end
end

Players.PlayerAdded:Connect(function(player)
    local stats = Instance.new("Folder")
    stats.Name = "leaderstats"
    stats.Parent = player
    for _, name in ipairs({"Coins", "Found", "Income"}) do
        local val = Instance.new("IntValue")
        val.Name = name
        val.Parent = stats
    end
    local s = {coins = 0, income = 0, found = {}}
    state[player] = s
    local ok, data = pcall(function()
        return store:GetAsync("p_" .. player.UserId)
    end)
    if ok and type(data) == "table" then
        s.coins = math.max(0, tonumber(data.coins) or 0)
        if type(data.found) == "table" then
            for id, has in pairs(data.found) do
                if type(id) == "string" and has == true then s.found[id] = true end
            end
        end
        recalc(player)
        local secondsAway = math.clamp(os.time() - (tonumber(data.lastSeen) or os.time()), 0, 43200)
        s.coins += s.income * secondsAway
    elseif not ok then
        warn("DataStore no disponible. Publica el juego y activa API Services para probar guardado en Studio.")
    end
    recalc(player)
    summary(player)
end)

sync.OnServerEvent:Connect(function(player, action)
    if action == "Get" then summary(player) end
end)

for _, item in ipairs(entries) do
    item.prompt.Triggered:Connect(function(player)
        local s = state[player]
        if not s or s.found[item.id] then return end
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not root or (root.Position - item.hitbox.Position).Magnitude &gt; 15 then return end
        s.found[item.id] = true
        s.coins += math.max(10, item.income * 10)
        recalc(player)
        summary(player)
        sync:FireClient(player, {toast = "¡Encontraste " .. item.title .. "!"})
    end)
end

task.spawn(function()
    local timeSinceSave = 0
    while true do
        task.wait(1)
        timeSinceSave += 1
        for player, s in pairs(state) do
            s.coins += s.income
            recalc(player)
        end
        if timeSinceSave &gt;= 90 then
            timeSinceSave = 0
            for player in pairs(state) do task.spawn(save, player) end
        end
    end
end)

Players.PlayerRemoving:Connect(function(player)
    save(player)
    state[player] = nil
end)

game:BindToClose(function()
    for player in pairs(state) do task.spawn(save, player) end
    task.wait(2)
end)
